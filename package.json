{
  "name": "cristalum-maroc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Site web premium CRISTALUM MAROC — Menuiserie aluminium & PVC sur mesure au Maroc",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "tsc -b",
    "images": "node scripts/optimize-images.mjs",
    "smoke": "vite build --ssr src/smoke/entry.tsx --outDir .smoke --emptyOutDir --logLevel warn && node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm run images && npm run build && npm run smoke"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "framer-motion": "12.43.0",
    "gsap": "3.15.0",
    "lucide-react": "0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "^30.1.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
